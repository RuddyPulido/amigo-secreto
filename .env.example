# Copie para .env.production (ou configure no CI) quando for usar um projeto Firebase real.
# O databaseURL não é segredo; as regras do banco é que definem o acesso.
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com
VITE_FIREBASE_API_KEY=sua-api-key
# URL pública usada nos convites enviados por WhatsApp (opcional em dev)
VITE_PUBLIC_URL=https://ruddypulido.github.io/amigo-secreto/
